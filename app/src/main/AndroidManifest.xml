<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only apps signed with the user's own key (SMS, Dialer) may hand over
         what contacts share through the encrypted chat. -->
    <permission
        android:name="${applicationId}.permission.CARDS"
        android:protectionLevel="signature" />

    <!-- SMS's encrypted chat invite, for the card given by touching phones;
         only SMS signed with the same key holds it. -->
    <uses-permission android:name="com.yaz.sms.permission.INVITE" />
    <uses-permission android:name="com.yaz.sms.debug.permission.INVITE" />
    <!-- When the user last called or wrote someone, and whom they talk with often
         unsaved: asked of Dialer and SMS, which only apps signed with the same key may ask. -->
    <uses-permission android:name="com.yaz.dialer.permission.PEOPLE" />
    <uses-permission android:name="com.yaz.dialer.debug.permission.PEOPLE" />
    <uses-permission android:name="com.yaz.sms.permission.PEOPLE" />
    <uses-permission android:name="com.yaz.sms.debug.permission.PEOPLE" />

    <!-- Only apps signed with the user's own key (Dialer, SMS) may ask the name of a private number. -->
    <permission
        android:name="${applicationId}.permission.PRIVATE"
        android:protectionLevel="signature" />

    <!-- One request to GitHub when the app opens, for the newest release. Nothing else goes out. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used when the user chooses to install updates from the app; Android asks them then. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The note after an update and while one downloads. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The contacts app: reads and keeps the people in Android's own contacts,
         which Dialer, SMS and every other app read. Nothing leaves the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Call calls at once, as in the phone app; without it the phone app opens with the number ready. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Reads another phone's contact QR code; asked the first time, the picture never leaves the phone. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Sharing a card by touching another phone, and reading theirs. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <!-- Lets the user feel a person's vibration while choosing it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Locking Contacts with the fingerprint, the face or the phone's PIN, through Android's own prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Hides other apps' floating windows over the editor and the delete
         question, so nothing can lay a false button over Save or Delete. Granted at install. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Knows when Android's Advanced Protection is on, to keep contacts out of screenshots then. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

    <!-- The apps a contact hands off to: the phone app calls, the messaging
         app writes, Dialer shows the calls with a number, mail and maps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- What other apps keep in a contact (a chat, a call), opened in them. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/*" />
        </intent>
        <provider android:authorities="com.yaz.sms.invite" />
        <provider android:authorities="com.yaz.sms.people" />
        <provider android:authorities="com.yaz.sms.debug.people" />
        <provider android:authorities="com.yaz.dialer.people" />
        <provider android:authorities="com.yaz.dialer.debug.people" />
        <provider android:authorities="com.yaz.sms.debug.invite" />
        <intent>
            <action android:name="com.yaz.sms.action.SHOW_KEYS" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="com.dialer.app.action.SHOW_NUMBER" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".ContactsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Contacts"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:memtagMode="sync">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Contacts">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Contacts" from another app: the whole list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/person" />
            </intent-filter>
        </activity>

        <!-- What other apps ask of the contacts app: show a contact, make or
             change one, pick one, read a contact card. Each opens over the
             app that asked and goes back to it when done. An intent only
             shows or fills: nothing is saved, deleted or sent without the
             user's own tap, and a pick returns only the row picked. -->
        <activity
            android:name=".HandOffActivity"
            android:exported="true"
            android:taskAffinity=""
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Contacts">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.provider.action.QUICK_CONTACT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/person" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/person" />
                <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
                <data android:mimeType="vnd.android.cursor.dir/phone" />
                <data android:mimeType="vnd.android.cursor.dir/email_v2" />
                <data android:mimeType="vnd.android.cursor.dir/postal-address_v2" />
                <data android:mimeType="vnd.android.cursor.dir/postal-address" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/person" />
                <data android:mimeType="vnd.android.cursor.item/phone_v2" />
                <data android:mimeType="vnd.android.cursor.item/phone" />
                <data android:mimeType="vnd.android.cursor.item/email_v2" />
                <data android:mimeType="vnd.android.cursor.item/postal-address_v2" />
                <data android:mimeType="vnd.android.cursor.item/postal-address" />
            </intent-filter>
            <!-- A contact card (vCard) opened from a message, a mail or the files. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
            <!-- A card read from another phone or a tag by touching it. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/x-vcard" />
            </intent-filter>
            <!-- A number or an address: its contact when there is one, else a new one. -->
            <intent-filter>
                <action android:name="com.android.contacts.action.SHOW_OR_CREATE_CONTACT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
                <data android:scheme="mailto" />
            </intent-filter>
        </activity>

        <!-- What the user's contacts share through the messaging app's encrypted
             chat, handed over by that app only (signature permission); kept as
             offers until the user applies them. Nothing can be read through it. -->
        <provider
            android:name=".data.contacts.CardsProvider"
            android:authorities="${applicationId}.cards"
            android:exported="true"
            android:permission="${applicationId}.permission.CARDS" />

        <!-- The name of a number kept private, for Dialer and SMS only; nothing can be listed. -->
        <provider
            android:name=".data.contacts.PrivateProvider"
            android:authorities="${applicationId}.private"
            android:exported="true"
            android:permission="${applicationId}.permission.PRIVATE" />

        <!-- The user's card as an NFC tag while the sharing screen is open.
             Only Android's NFC service may bind it. -->
        <service
            android:name=".core.nfc.CardTagService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/card_tag" />
        </service>

        <!-- Pictures from outside are decoded here, in a process of its own
             with no permission, no files and no network. -->
        <service
            android:name=".core.security.DecoderService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":decoder" />

        <!-- The favourites on the home screen. Only Android's widget host sends to it. -->
        <receiver
            android:name=".widget.FavoritesWidget"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favorites_widget" />
        </receiver>
        <!-- The widget's faces, read only by Android's widget host. -->
        <service
            android:name=".widget.FavoritesWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- After an update the app installed itself: a notification to open it again. -->
        <receiver
            android:name=".core.update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
