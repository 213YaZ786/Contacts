<resources>
    <!-- The launcher icon follows the wallpaper: the disc in the accent, the
         ground the disc's own tone (its rim grey is white at the edge), so no
         pale ring shows around it, as Dialer's and Launcher's. The glyph
         colour is the icon shortcuts'. -->
    <color name="ic_launcher_background">@android:color/system_accent1_500</color>
    <color name="ic_launcher_disc">@android:color/system_accent1_500</color>
    <color name="ic_launcher_glyph">@android:color/system_accent1_600</color>
    <!-- The icon shortcuts keep the palest tone under their glyph. -->
    <color name="ic_shortcut_background">@android:color/system_accent1_50</color>
    <color name="widget_ground">@android:color/system_accent1_50</color>
    <color name="widget_ink">@android:color/system_neutral1_900</color>
</resources>
