<?xml version="1.0" encoding="utf-8"?>
<!-- Contacts' launcher glyph: a glossy disc with a person in relief, as
     Dialer's disc and handset. The disc's grey body is multiplied by a tone
     of the wallpaper's accent, its white rim lights it, untinted, and the
     person lies on top as drawn. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/people_body"
            android:tint="@color/ic_launcher_disc"
            android:tintMode="multiply" />
    </item>
    <item android:drawable="@drawable/people_shine" />
    <item android:drawable="@drawable/people_person" />
</layer-list>
