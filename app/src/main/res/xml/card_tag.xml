<?xml version="1.0" encoding="utf-8"?>
<!-- The user's card as an NFC tag: answered only with the phone unlocked. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/card_tag"
    android:requireDeviceUnlock="true">
    <aid-group android:category="other" android:description="@string/card_tag">
        <!-- The NFC Forum's NDEF Tag Application. -->
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
